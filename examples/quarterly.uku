    {"name": "cagr", "expression": {"op": "sub", "left": {"op": "power", "left": {"op": "div", "left": {"op": "last", "name": "revenue_12m"}, "right": {"op": "first", "name": "revenue_12m"}}, "right": {"op": "div", "left": {"op": "literal", "value": "1"}, "right": {"op": "name", "name": "years"}}}, "right": {"op": "literal", "value": "1"}}},
    {"name": "revenue_growth_a", "expression": {"op": "sub", "left": {"op": "div", "left": {"op": "name", "name": "revenue_a"}, "right": {"op": "name", "name": "revenue_4q"}}, "right": {"op": "literal", "value": "1"}}},
