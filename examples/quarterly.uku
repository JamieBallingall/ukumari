    {"name": "ebitda_1q_f", "expression": {"op": "lag", "body": {"op": "name", "name": "ebitda"}, "seed": {"op": "name", "name": "start_ebitda_0q_f"}}},
    {"name": "ebitda_2q_f", "expression": {"op": "lag", "body": {"op": "name", "name": "ebitda_1q_f"}, "seed": {"op": "name", "name": "start_ebitda_1q_f"}}},
    {"name": "ebitda_3q_f", "expression": {"op": "lag", "body": {"op": "name", "name": "ebitda_2q_f"}, "seed": {"op": "name", "name": "start_ebitda_2q_f"}}},
