    {"name": "quarter_number", "expression": {"op": "lag", "body": {"op": "add", "left": {"op": "name", "name": "quarter_number"}, "right": {"op": "literal", "value": "1"}}, "seed": {"op": "literal", "value": "1"}}},
    {"name": "revenue_a", "expression": {"op": "name", "name": "revenue_actual"}},
