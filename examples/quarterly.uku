  "equations": [
    {"name": "gross_profit_actual", "expression": {"op": "sub", "left": {"op": "name", "name": "revenue_actual"}, "right": {"op": "name", "name": "cost_of_sales_actual"}}},
    {"name": "ebitda_actual", "expression": {"op": "sub", "left": {"op": "name", "name": "gross_profit_actual"}, "right": {"op": "name", "name": "operating_expenses_actual"}}},
    {"name": "operating_profit_actual", "expression": {"op": "sub", "left": {"op": "name", "name": "ebitda_actual"}, "right": {"op": "name", "name": "depreciation_actual"}}},
    {"name": "profit_before_tax_actual", "expression": {"op": "sub", "left": {"op": "name", "name": "operating_profit_actual"}, "right": {"op": "name", "name": "interest_actual"}}},
    {"name": "net_income_actual", "expression": {"op": "sub", "left": {"op": "name", "name": "profit_before_tax_actual"}, "right": {"op": "name", "name": "tax_actual"}}},
    {"name": "total_assets_actual", "expression": {"op": "add", "left": {"op": "add", "left": {"op": "add", "left": {"op": "name", "name": "cash_actual"}, "right": {"op": "name", "name": "receivables_actual"}}, "right": {"op": "name", "name": "inventory_actual"}}, "right": {"op": "name", "name": "ppe_actual"}}},
    {"name": "total_liabilities_and_equity_actual", "expression": {"op": "add", "left": {"op": "add", "left": {"op": "add", "left": {"op": "add", "left": {"op": "add", "left": {"op": "name", "name": "payables_actual"}, "right": {"op": "name", "name": "revolver_actual"}}, "right": {"op": "name", "name": "bond_a_actual"}}, "right": {"op": "name", "name": "bond_b_actual"}}, "right": {"op": "name", "name": "term_loan_actual"}}, "right": {"op": "name", "name": "equity_actual"}}},
    {"name": "balance_check_actual", "expression": {"op": "sub", "left": {"op": "name", "name": "total_assets_actual"}, "right": {"op": "name", "name": "total_liabilities_and_equity_actual"}}},
    {"name": "cost_of_sales_pct_stretched", "expression": {"op": "name", "name": "cost_of_sales_pct"}},
    {"name": "operating_expenses_pct_stretched", "expression": {"op": "name", "name": "operating_expenses_pct"}},
