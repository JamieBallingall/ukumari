    {"name": "price_effect_a", "expression": {"op": "mul", "left": {"op": "name", "name": "price_beta"}, "right": {"op": "sub", "left": {"op": "name", "name": "price_change_actual"}, "right": {"op": "name", "name": "price_average"}}}},
