    {"name": "receivables", "expression": {"op": "mul", "left": {"op": "div", "left": {"op": "name", "name": "revenue"}, "right": {"op": "name", "name": "days"}}, "right": {"op": "name", "name": "receivable_days_f"}}},
    {"name": "inventory", "expression": {"op": "mul", "left": {"op": "div", "left": {"op": "name", "name": "cost_of_sales"}, "right": {"op": "name", "name": "days"}}, "right": {"op": "name", "name": "inventory_days_f"}}},
    {"name": "payables", "expression": {"op": "mul", "left": {"op": "div", "left": {"op": "name", "name": "cost_of_sales"}, "right": {"op": "name", "name": "days"}}, "right": {"op": "name", "name": "payable_days_f"}}},
    {"name": "working_capital", "expression": {"op": "sub", "left": {"op": "add", "left": {"op": "name", "name": "receivables"}, "right": {"op": "name", "name": "inventory"}}, "right": {"op": "name", "name": "payables"}}},
    {"name": "working_capital_increase", "expression": {"op": "sub", "left": {"op": "name", "name": "working_capital"}, "right": {"op": "lag", "body": {"op": "name", "name": "working_capital"}, "seed": {"op": "sub", "left": {"op": "add", "left": {"op": "name", "name": "start_receivables_f"}, "right": {"op": "name", "name": "start_inventory_f"}}, "right": {"op": "name", "name": "start_payables_f"}}}}},
    {"name": "bond_a_quarters_left", "expression": {"op": "sub", "left": {"op": "lag", "body": {"op": "name", "name": "bond_a_quarters_left"}, "seed": {"op": "name", "name": "bond_a_quarters_f"}}, "right": {"op": "literal", "value": "1"}}},
