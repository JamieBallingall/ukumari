    {"name": "opening_cash", "expression": {"op": "lag", "body": {"op": "name", "name": "cash"}, "seed": {"op": "name", "name": "start_cash_f"}}},
    {"name": "available", "expression": {"op": "sub", "left": {"op": "sub", "left": {"op": "add", "left": {"op": "sub", "left": {"op": "name", "name": "opening_cash"}, "right": {"op": "name", "name": "minimum_cash_f"}}, "right": {"op": "name", "name": "cash_from_operations"}}, "right": {"op": "name", "name": "capex"}}, "right": {"op": "name", "name": "scheduled_repayment"}}},
    {"name": "dividends", "expression": {"op": "min", "left": {"op": "name", "name": "dividend_f"}, "right": {"op": "max", "left": {"op": "name", "name": "available"}, "right": {"op": "literal", "value": "0"}}}},
    {"name": "after_dividends", "expression": {"op": "sub", "left": {"op": "name", "name": "available"}, "right": {"op": "name", "name": "dividends"}}},
