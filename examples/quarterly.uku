    {"name": "surprise_4q_f", "expression": {"op": "lag", "body": {"op": "name", "name": "surprise_3q_f"}, "seed": {"op": "name", "name": "start_surprise_3q_f"}}},
    {"name": "surprise_5q_f", "expression": {"op": "lag", "body": {"op": "name", "name": "surprise_4q_f"}, "seed": {"op": "name", "name": "start_surprise_4q_f"}}},
    {"name": "surprise", "expression": {"op": "sub", "left": {"op": "add", "left": {"op": "mul", "left": {"op": "name", "name": "ar_f"}, "right": {"op": "name", "name": "surprise_1q_f"}}, "right": {"op": "mul", "left": {"op": "name", "name": "seasonal_ar_f"}, "right": {"op": "name", "name": "surprise_4q_f"}}}, "right": {"op": "mul", "left": {"op": "mul", "left": {"op": "name", "name": "ar_f"}, "right": {"op": "name", "name": "seasonal_ar_f"}}, "right": {"op": "name", "name": "surprise_5q_f"}}}},
