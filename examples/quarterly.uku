    {"name": "total_liabilities_and_equity", "expression": {"op": "add", "left": {"op": "add", "left": {"op": "add", "left": {"op": "add", "left": {"op": "add", "left": {"op": "name", "name": "payables_bs"}, "right": {"op": "name", "name": "revolver_bs"}}, "right": {"op": "name", "name": "bond_a_bs"}}, "right": {"op": "name", "name": "bond_b_bs"}}, "right": {"op": "name", "name": "term_loan_bs"}}, "right": {"op": "name", "name": "equity_bs"}}},
    {"name": "balance_check", "expression": {"op": "sub", "left": {"op": "name", "name": "total_assets"}, "right": {"op": "name", "name": "total_liabilities_and_equity"}}},
    {"name": "working_capital_cf", "expression": {"op": "neg", "operand": {"op": "name", "name": "working_capital_increase"}}},
    {"name": "cash_from_operations_cf", "expression": {"op": "add", "left": {"op": "add", "left": {"op": "name", "name": "net_income_cf"}, "right": {"op": "name", "name": "depreciation_cf"}}, "right": {"op": "name", "name": "working_capital_cf"}}},
    {"name": "capex_cf", "expression": {"op": "neg", "operand": {"op": "name", "name": "capex"}}},
    {"name": "debt_repaid_cf", "expression": {"op": "neg", "operand": {"op": "name", "name": "scheduled_repayment"}}},
    {"name": "dividends_cf", "expression": {"op": "neg", "operand": {"op": "name", "name": "dividends"}}},
    {"name": "buybacks_cf", "expression": {"op": "neg", "operand": {"op": "name", "name": "buybacks"}}},
    {"name": "cash_from_financing", "expression": {"op": "add", "left": {"op": "add", "left": {"op": "add", "left": {"op": "name", "name": "debt_repaid_cf"}, "right": {"op": "name", "name": "revolver_drawn_cf"}}, "right": {"op": "name", "name": "dividends_cf"}}, "right": {"op": "name", "name": "buybacks_cf"}}},
    {"name": "net_change_in_cash", "expression": {"op": "add", "left": {"op": "add", "left": {"op": "name", "name": "cash_from_operations_cf"}, "right": {"op": "name", "name": "capex_cf"}}, "right": {"op": "name", "name": "cash_from_financing"}}},
    {"name": "net_debt", "expression": {"op": "sub", "left": {"op": "name", "name": "debt"}, "right": {"op": "name", "name": "cash"}}},
    {"name": "debt_to_ebitda", "expression": {"op": "div", "left": {"op": "name", "name": "debt"}, "right": {"op": "name", "name": "ebitda_12m"}}},
    {"name": "net_debt_to_ebitda", "expression": {"op": "div", "left": {"op": "name", "name": "net_debt"}, "right": {"op": "name", "name": "ebitda_12m"}}},
    {"name": "interest_cover", "expression": {"op": "div", "left": {"op": "name", "name": "ebitda"}, "right": {"op": "name", "name": "interest"}}},
    {"name": "revolver_room", "expression": {"op": "sub", "left": {"op": "name", "name": "revolver_limit_f"}, "right": {"op": "name", "name": "revolver"}}},
    {"name": "liquidity", "expression": {"op": "add", "left": {"op": "name", "name": "cash"}, "right": {"op": "name", "name": "revolver_room"}}}
  ]
}
