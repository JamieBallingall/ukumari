    {"name": "cash", "expression": {"op": "sub", "left": {"op": "add", "left": {"op": "name", "name": "minimum_cash_f"}, "right": {"op": "name", "name": "after_revolver"}}, "right": {"op": "name", "name": "buybacks"}}},
    {"name": "revolver", "expression": {"op": "add", "left": {"op": "name", "name": "opening_revolver"}, "right": {"op": "name", "name": "revolver_drawn"}}},
