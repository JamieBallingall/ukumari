    {"name": "interest", "expression": {"op": "div", "left": {"op": "mul", "left": {"op": "lag", "body": {"op": "name", "name": "debt"}, "seed": {"op": "add", "left": {"op": "add", "left": {"op": "add", "left": {"op": "name", "name": "start_revolver_f"}, "right": {"op": "name", "name": "start_bond_a_f"}}, "right": {"op": "name", "name": "start_bond_b_f"}}, "right": {"op": "name", "name": "start_term_loan_f"}}}, "right": {"op": "name", "name": "interest_rate_f"}}, "right": {"op": "literal", "value": "4"}}},
