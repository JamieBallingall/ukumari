    {"name": "bond_b_quarters_left", "expression": {"op": "sub", "left": {"op": "lag", "body": {"op": "name", "name": "bond_b_quarters_left"}, "seed": {"op": "name", "name": "bond_b_quarters_f"}}, "right": {"op": "literal", "value": "1"}}},
