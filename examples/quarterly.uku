    {"name": "net_debt_to_ebitda", "expression": {"op": "div", "left": {"op": "name", "name": "net_debt"}, "right": {"op": "name", "name": "ebitda_12m"}}},
    {"name": "interest_cover", "expression": {"op": "div", "left": {"op": "name", "name": "ebitda"}, "right": {"op": "name", "name": "interest"}}}
