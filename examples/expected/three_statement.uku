{
  "format": "ukumari.model",
  "version": 1,
  "axes": [
    {"name": "year", "regions": ["actual", "forecast"]}
  ],
  "declarations": [
    {"name": "year_actual", "kind": "input", "shape": {"region": "actual", "front": 0, "back": 0}},
    {"name": "year", "kind": "input", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "growth", "kind": "input", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "scheduled_repayment", "kind": "input", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "cost_of_sales_pct", "kind": "input", "shape": "scalar"},
    {"name": "operating_expense_pct", "kind": "input", "shape": "scalar"},
    {"name": "depreciation_rate", "kind": "input", "shape": "scalar"},
    {"name": "interest_rate", "kind": "input", "shape": "scalar"},
    {"name": "tax_rate", "kind": "input", "shape": "scalar"},
    {"name": "receivables_pct", "kind": "input", "shape": "scalar"},
    {"name": "payables_pct", "kind": "input", "shape": "scalar"},
    {"name": "capex_pct", "kind": "input", "shape": "scalar"},
    {"name": "payout_ratio", "kind": "input", "shape": "scalar"},
    {"name": "revenue_actual", "kind": "input", "shape": {"region": "actual", "front": 0, "back": 0}},
    {"name": "cash_actual", "kind": "input", "shape": {"region": "actual", "front": 0, "back": 0}},
    {"name": "receivables_actual", "kind": "input", "shape": {"region": "actual", "front": 0, "back": 0}},
    {"name": "ppe_actual", "kind": "input", "shape": {"region": "actual", "front": 0, "back": 0}},
    {"name": "payables_actual", "kind": "input", "shape": {"region": "actual", "front": 0, "back": 0}},
    {"name": "debt_actual", "kind": "input", "shape": {"region": "actual", "front": 0, "back": 0}},
    {"name": "equity_actual", "kind": "input", "shape": {"region": "actual", "front": 0, "back": 0}},
    {"name": "total_assets_actual", "kind": "vector", "shape": {"region": "actual", "front": 0, "back": 0}},
    {"name": "liabilities_and_equity_actual", "kind": "vector", "shape": {"region": "actual", "front": 0, "back": 0}},
    {"name": "check_actual", "kind": "vector", "shape": {"region": "actual", "front": 0, "back": 0}},
    {"name": "revenue", "kind": "vector", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "cost_of_sales", "kind": "vector", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "gross_profit", "kind": "vector", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "operating_expenses", "kind": "vector", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "depreciation", "kind": "vector", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "operating_profit", "kind": "vector", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "interest", "kind": "vector", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "profit_before_tax", "kind": "vector", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "tax", "kind": "vector", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "net_income", "kind": "vector", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "change_in_receivables", "kind": "vector", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "change_in_payables", "kind": "vector", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "cash_from_operations", "kind": "vector", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "capital_expenditure", "kind": "vector", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "debt_repayment", "kind": "vector", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "dividends", "kind": "vector", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "net_change_in_cash", "kind": "vector", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "cash", "kind": "vector", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "receivables", "kind": "vector", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "ppe", "kind": "vector", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "total_assets", "kind": "vector", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "payables", "kind": "vector", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "debt", "kind": "vector", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "equity", "kind": "vector", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "liabilities_and_equity", "kind": "vector", "shape": {"region": "forecast", "front": 0, "back": 0}},
    {"name": "check", "kind": "vector", "shape": {"region": "forecast", "front": 0, "back": 0}}
  ],
  "equations": [
    {"name": "total_assets_actual", "expression": {"op": "add", "left": {"op": "add", "left": {"op": "name", "name": "cash_actual"}, "right": {"op": "name", "name": "receivables_actual"}}, "right": {"op": "name", "name": "ppe_actual"}}},
    {"name": "liabilities_and_equity_actual", "expression": {"op": "add", "left": {"op": "add", "left": {"op": "name", "name": "payables_actual"}, "right": {"op": "name", "name": "debt_actual"}}, "right": {"op": "name", "name": "equity_actual"}}},
    {"name": "check_actual", "expression": {"op": "sub", "left": {"op": "name", "name": "total_assets_actual"}, "right": {"op": "name", "name": "liabilities_and_equity_actual"}}},
    {"name": "revenue", "expression": {"op": "mul", "left": {"op": "lag", "body": {"op": "name", "name": "revenue"}, "seed": {"op": "last", "name": "revenue_actual"}}, "right": {"op": "add", "left": {"op": "literal", "value": "1"}, "right": {"op": "name", "name": "growth"}}}},
    {"name": "cost_of_sales", "expression": {"op": "mul", "left": {"op": "name", "name": "revenue"}, "right": {"op": "name", "name": "cost_of_sales_pct"}}},
    {"name": "gross_profit", "expression": {"op": "sub", "left": {"op": "name", "name": "revenue"}, "right": {"op": "name", "name": "cost_of_sales"}}},
    {"name": "operating_expenses", "expression": {"op": "mul", "left": {"op": "name", "name": "revenue"}, "right": {"op": "name", "name": "operating_expense_pct"}}},
    {"name": "depreciation", "expression": {"op": "mul", "left": {"op": "lag", "body": {"op": "name", "name": "ppe"}, "seed": {"op": "last", "name": "ppe_actual"}}, "right": {"op": "name", "name": "depreciation_rate"}}},
    {"name": "operating_profit", "expression": {"op": "sub", "left": {"op": "sub", "left": {"op": "name", "name": "gross_profit"}, "right": {"op": "name", "name": "operating_expenses"}}, "right": {"op": "name", "name": "depreciation"}}},
    {"name": "interest", "expression": {"op": "mul", "left": {"op": "lag", "body": {"op": "name", "name": "debt"}, "seed": {"op": "last", "name": "debt_actual"}}, "right": {"op": "name", "name": "interest_rate"}}},
    {"name": "profit_before_tax", "expression": {"op": "sub", "left": {"op": "name", "name": "operating_profit"}, "right": {"op": "name", "name": "interest"}}},
    {"name": "tax", "expression": {"op": "mul", "left": {"op": "name", "name": "profit_before_tax"}, "right": {"op": "name", "name": "tax_rate"}}},
    {"name": "net_income", "expression": {"op": "sub", "left": {"op": "name", "name": "profit_before_tax"}, "right": {"op": "name", "name": "tax"}}},
    {"name": "change_in_receivables", "expression": {"op": "sub", "left": {"op": "lag", "body": {"op": "name", "name": "receivables"}, "seed": {"op": "last", "name": "receivables_actual"}}, "right": {"op": "name", "name": "receivables"}}},
    {"name": "change_in_payables", "expression": {"op": "sub", "left": {"op": "name", "name": "payables"}, "right": {"op": "lag", "body": {"op": "name", "name": "payables"}, "seed": {"op": "last", "name": "payables_actual"}}}},
    {"name": "cash_from_operations", "expression": {"op": "add", "left": {"op": "add", "left": {"op": "add", "left": {"op": "name", "name": "net_income"}, "right": {"op": "name", "name": "depreciation"}}, "right": {"op": "name", "name": "change_in_receivables"}}, "right": {"op": "name", "name": "change_in_payables"}}},
    {"name": "capital_expenditure", "expression": {"op": "neg", "operand": {"op": "mul", "left": {"op": "name", "name": "revenue"}, "right": {"op": "name", "name": "capex_pct"}}}},
    {"name": "debt_repayment", "expression": {"op": "neg", "operand": {"op": "min", "left": {"op": "name", "name": "scheduled_repayment"}, "right": {"op": "lag", "body": {"op": "name", "name": "debt"}, "seed": {"op": "last", "name": "debt_actual"}}}}},
    {"name": "dividends", "expression": {"op": "neg", "operand": {"op": "mul", "left": {"op": "name", "name": "net_income"}, "right": {"op": "name", "name": "payout_ratio"}}}},
    {"name": "net_change_in_cash", "expression": {"op": "add", "left": {"op": "add", "left": {"op": "add", "left": {"op": "name", "name": "cash_from_operations"}, "right": {"op": "name", "name": "capital_expenditure"}}, "right": {"op": "name", "name": "debt_repayment"}}, "right": {"op": "name", "name": "dividends"}}},
    {"name": "cash", "expression": {"op": "add", "left": {"op": "lag", "body": {"op": "name", "name": "cash"}, "seed": {"op": "last", "name": "cash_actual"}}, "right": {"op": "name", "name": "net_change_in_cash"}}},
    {"name": "receivables", "expression": {"op": "mul", "left": {"op": "name", "name": "revenue"}, "right": {"op": "name", "name": "receivables_pct"}}},
    {"name": "ppe", "expression": {"op": "sub", "left": {"op": "sub", "left": {"op": "lag", "body": {"op": "name", "name": "ppe"}, "seed": {"op": "last", "name": "ppe_actual"}}, "right": {"op": "name", "name": "capital_expenditure"}}, "right": {"op": "name", "name": "depreciation"}}},
    {"name": "total_assets", "expression": {"op": "add", "left": {"op": "add", "left": {"op": "name", "name": "cash"}, "right": {"op": "name", "name": "receivables"}}, "right": {"op": "name", "name": "ppe"}}},
    {"name": "payables", "expression": {"op": "mul", "left": {"op": "name", "name": "cost_of_sales"}, "right": {"op": "name", "name": "payables_pct"}}},
    {"name": "debt", "expression": {"op": "add", "left": {"op": "lag", "body": {"op": "name", "name": "debt"}, "seed": {"op": "last", "name": "debt_actual"}}, "right": {"op": "name", "name": "debt_repayment"}}},
    {"name": "equity", "expression": {"op": "add", "left": {"op": "add", "left": {"op": "lag", "body": {"op": "name", "name": "equity"}, "seed": {"op": "last", "name": "equity_actual"}}, "right": {"op": "name", "name": "net_income"}}, "right": {"op": "name", "name": "dividends"}}},
    {"name": "liabilities_and_equity", "expression": {"op": "add", "left": {"op": "add", "left": {"op": "name", "name": "payables"}, "right": {"op": "name", "name": "debt"}}, "right": {"op": "name", "name": "equity"}}},
    {"name": "check", "expression": {"op": "sub", "left": {"op": "name", "name": "total_assets"}, "right": {"op": "name", "name": "liabilities_and_equity"}}}
  ]
}
